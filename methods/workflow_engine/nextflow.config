// Nextflow config — mirrors config.yaml keys. Processed GEO only. No FASTQ.

params {
    workdir = "results/workflow_engine"
    max_file_bytes = 2147483648
    refuse_fastq = true
    collapse_duplicate_genes = "max_mean"
    deconv_methods = ["quantiseq", "epic", "mcp_counter", "xcell"]
    cibersort_binary = null
    cibersort_mat = null

    genes {
        TACSTD2 {
            ensembl = "ENSG00000184292"
            aliases = ["TACSTD2", "TROP2", "M1S1", "GA733-1", "EGP-1", "EGP1", "GP50"]
        }
        CLDN4 {
            ensembl = "ENSG00000189143"
            aliases = ["CLDN4", "CPE-R", "CPETR1", "WBSCR8", "hCPE-R"]
        }
    }

    // Accessions opened on NCBI GEO HTML (2026-08-16). Do not invent GSEs.
    cohorts {
        GSE126044 {
            species = "human"
            assay = "bulk_rnaseq"
            unit = "count"
            panel = "genome_wide"
            gse = "GSE126044"
            soft_url = "https://ftp.ncbi.nlm.nih.gov/geo/series/GSE126nnn/GSE126044/soft/GSE126044_family.soft.gz"
            processed_url = "https://www.ncbi.nlm.nih.gov/geo/download/?acc=GSE126044&format=file&file=GSE126044_counts.txt.gz"
            processed_name = "GSE126044_counts.txt.gz"
            pheno_url = null
            note = "NSCLC anti-PD-1; author counts. Verify response in SOFT."
        }
        GSE135222 {
            species = "human"
            assay = "bulk_rnaseq"
            unit = "unknown"
            panel = "genome_wide"
            gse = "GSE135222"
            soft_url = "https://ftp.ncbi.nlm.nih.gov/geo/series/GSE135nnn/GSE135222/soft/GSE135222_family.soft.gz"
            processed_url = "https://www.ncbi.nlm.nih.gov/geo/download/?acc=GSE135222&format=file&file=GSE135222_GEO_RNA-seq_omicslab_exp.tsv.gz"
            processed_name = "GSE135222_GEO_RNA-seq_omicslab_exp.tsv.gz"
            pheno_url = null
            note = "NSCLC ICI; PFS often in characteristics. Confirm expression unit from header."
        }
        GSE166449 {
            species = "human"
            assay = "bulk_rnaseq"
            unit = "tpm"
            panel = "genome_wide"
            gse = "GSE166449"
            soft_url = "https://ftp.ncbi.nlm.nih.gov/geo/series/GSE166nnn/GSE166449/soft/GSE166449_family.soft.gz"
            processed_url = "https://www.ncbi.nlm.nih.gov/geo/download/?acc=GSE166449&format=file&file=GSE166449_Raw_gene_TPM_matrix.txt.gz"
            processed_name = "GSE166449_Raw_gene_TPM_matrix.txt.gz"
            pheno_url = null
            note = "SMC_IO TPM. Restrict to lung samples if the series is multi-cancer."
        }
        GSE207422 {
            species = "human"
            assay = "bulk_rnaseq"
            unit = "log2tpm"
            panel = "genome_wide"
            gse = "GSE207422"
            soft_url = "https://ftp.ncbi.nlm.nih.gov/geo/series/GSE207nnn/GSE207422/soft/GSE207422_family.soft.gz"
            processed_url = "https://www.ncbi.nlm.nih.gov/geo/download/?acc=GSE207422&format=file&file=GSE207422_NSCLC_bulk_RNAseq_log2TPM.txt.gz"
            processed_name = "GSE207422_NSCLC_bulk_RNAseq_log2TPM.txt.gz"
            pheno_url = "https://www.ncbi.nlm.nih.gov/geo/download/?acc=GSE207422&format=file&file=GSE207422_NSCLC_bulk_RNAseq_metadata.xlsx"
            note = "Neoadjuvant PD-1+chemo; MPR in xlsx. Invert log2TPM before deconv. No scRNA UMI in this engine."
        }
        GSE136961 {
            species = "human"
            assay = "targeted_panel"
            unit = "tpm"
            panel = "oncomine_immune"
            gse = "GSE136961"
            soft_url = "https://ftp.ncbi.nlm.nih.gov/geo/series/GSE136nnn/GSE136961/soft/GSE136961_family.soft.gz"
            processed_url = "https://www.ncbi.nlm.nih.gov/geo/download/?acc=GSE136961&format=file&file=GSE136961_TPM.tsv.gz"
            processed_name = "GSE136961_TPM.tsv.gz"
            pheno_url = null
            note = "Oncomine Immune Response panel. Expect missing TACSTD2/CLDN4; skip deconv."
        }
    }
}

workDir = "${params.workdir}/nf_work"

profiles {
    conda {
        conda.enabled = true
        conda.useMamba = true
    }
    standard {
        process.executor = "local"
    }
}

process {
    errorStrategy = "terminate"
}

manifest {
    name = "trop2-cldn4-geo-processed"
    description = "Skeleton: GEO processed → TACSTD2/CLDN4 → deconv → stats → figures. No FASTQ."
    nextflowVersion = ">=23.04.0"
}
